<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <DataTemplate.Resources>
        <Style x:Key="DshButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="RoyalBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="WhiteSmoke"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DshTextBoxStyle" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </DataTemplate.Resources>
    <Grid ClipToBounds="True" MinWidth="0" MinHeight="0" Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <wv2:WebView2 x:Name="Browser"
                      Grid.Row="0"
                      Source="{Binding BrowserSource}"
                      Visibility="{Binding BrowserVisibility}"/>
        <Border Grid.Row="0" Background="WhiteSmoke" ClipToBounds="True"
                    Visibility="{Binding OverlayVisibility}">
            <Grid MaxWidth="480" MinWidth="0" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DSH Web UI 未运行"
                           FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="{Binding Detail}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <Button Grid.Row="4" Command="{Binding StartWebCommand}"
                        Content="启动 Web UI" HorizontalAlignment="Center"
                        Style="{StaticResource DshButtonStyle}"/>
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Text="{Binding WebOutput}" IsReadOnly="True"
                             Height="96" Padding="8,4" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="DSH Web UI 启动输出"
                             Style="{StaticResource DshTextBoxStyle}"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding WebCommand}" IsReadOnly="True"
                                 Padding="8,4" VerticalContentAlignment="Center"
                                 ToolTip="在终端中运行此命令启动 DSH Web UI"
                                 Style="{StaticResource DshTextBoxStyle}"/>
                        <TextBox Grid.Column="2" Text="{Binding WebPort, UpdateSourceTrigger=PropertyChanged}"
                                 Width="72" Padding="8,4" VerticalContentAlignment="Center"
                                  ToolTip="Web UI 监听端口，默认 13080"
                                 Style="{StaticResource DshTextBoxStyle}"/>
                        <Button Grid.Column="4" Command="{Binding CopyWebCommand}"
                                Content="复制命令" Style="{StaticResource DshButtonStyle}"/>
                    </Grid>
                    <StackPanel Grid.Row="6">
                        <TextBlock Text="运行环境：" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding EnvironmentStatus}" Margin="0,4,0,8"
                                    TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding CheckEnvironmentCommand}" Content="重新检查"
                                    Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                    Style="{StaticResource DshButtonStyle}"/>
                            <Button Grid.Column="1" Command="{Binding InstallNodeCommand}" Content="安装 Node.js"
                                    Margin="4,0" HorizontalAlignment="Stretch"
                                    Style="{StaticResource DshButtonStyle}"/>
                            <Button Grid.Column="2" Command="{Binding InstallDshCommand}" Content="安装 DSH"
                                    Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                    Style="{StaticResource DshButtonStyle}"/>
                        </Grid>
                        <TextBlock Text="DSH 路径：" Margin="0,8,0,4"
                                   FontWeight="SemiBold"/>
                        <TextBox Text="{Binding DshPath}" IsReadOnly="True"
                                 Padding="8,4" VerticalContentAlignment="Center"
                                 ToolTip="DSH 命令可执行程序或脚本的所在位置"
                                 Style="{StaticResource DshTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="WhiteSmoke" Padding="8,2"
                ClipToBounds="True" Visibility="{Binding BrowserVisibility}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="DSH Web UI" VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="{Binding WebAddress}"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding DshVersion}"
                           VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="{Binding WebProcessId}"
                           VerticalAlignment="Center"/>
                    <Button Grid.Column="8" Command="{Binding StopWebCommand}"
                        Content="停止 DSH Web UI" Style="{StaticResource DshButtonStyle}"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Background="Gainsboro" Padding="8,2" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="4" Height="4"
                             VerticalAlignment="Center"
                             ToolTip="{Binding ActiveContextState}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9E9E9E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveContextState}" Value="connected">
                                        <Setter Property="Fill" Value="#1ABC9C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActiveContextState}" Value="notconnected">
                                        <Setter Property="Fill" Value="#F39C12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="2" Text="{Binding ActiveContextStatus}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               ToolTip="当前 Visual Studio 活动上下文"/>
                </Grid>
            </ScrollViewer>
        </Border>

    </Grid>
</DataTemplate>