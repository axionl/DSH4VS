<Window x:Class="DSH4VS.UI.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" 
        xmlns:ui="clr-namespace:DSH4VS.UI" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=ui:PromptDialogViewModel}"
        Title="Ask DSH" Height="520" Width="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource RegionBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ExpanderStyle" TargetType="{x:Type Expander}"
                BasedOn="{StaticResource ExpanderBaseStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Border Name="BorderBack" BorderThickness="4, 0, 0, 0" 
                                    BorderBrush="{DynamicResource PrimaryBrush}"/>
                                <TextBlock FontSize="16" FontWeight="Normal" Text="{Binding}"
                                    Foreground="{DynamicResource PrimaryTextBrush}" 
                                    Margin="4, 0, 0, 0"/>
                            </DockPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <ui:PromptDialogViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="任务说明" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
             MinHeight="120" Margin="0,0,0,8"/>

        <Expander Grid.Row="2" Header="运行环境" IsExpanded="False" Margin="0,0,0,8"
                  Background="White" Style="{StaticResource ExpanderStyle}">
            <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Margin="0,4,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding EnvironmentStatus}" TextWrapping="Wrap"
                        Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                    <WrapPanel Grid.Row="1">
                        <Button Command="{Binding CheckEnvironmentCommand}" Margin="0,0,8,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ShieldRefreshOutline" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="检查"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallNodeCommand}" IsEnabled="{Binding CanInstallNode}"
                            Margin="0,0,8,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Nodejs" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="安装 Node.js"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding InstallDshCommand}" IsEnabled="{Binding CanInstallDsh}" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CloudDownloadOutline" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="安装 DSH"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
        </Expander>

        <TextBlock Grid.Row="3" Text="{Binding ContextSummary}" TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>
        <WrapPanel Grid.Row="4" Margin="0,0,0,8">
            <CheckBox IsChecked="{Binding IncludeSelection}" IsEnabled="{Binding HasSelection}"
                Content="包含选中文本" Margin="0,0,12,0"/>
            <CheckBox IsChecked="{Binding IncludeFile}" IsEnabled="{Binding HasFile}"
                Content="包含当前文件"/>
        </WrapPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button IsCancel="True" Padding="12,0" Margin="0,0,8,0"
                    Style="{StaticResource ButtonWarning}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,4,0"/>
                    <TextBlock Text="取消"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RunCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    IsDefault="True" Padding="12,0"
                    Style="{StaticResource ButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" Margin="0,0,4,0"/>
                    <TextBlock Text="运行"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>